@typeparam TEntity where TEntity : BaseViewModel, INamedViewModel, new()

@using FilmsServices.Services.Common
@using FilmsServices.ViewModel.Common

@inject IJSRuntime JS


<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="mb-0">@Title</h1>
    <button class="btn btn-success" @onclick="StartAdd">Добавить</button>
</div>


<div class="row g-2 align-items-end mb-3">
    <div class="col-md-6">
        <label class="form-label">Поиск по имени</label>
        <input class="form-control"
               @bind="searchText"
               @bind:event="oninput"
               @onkeydown="OnSearchKeyDown"
               placeholder="Введите часть имени" />
    </div>
    <div class="col-md-auto">
        <button class="btn btn-primary" @onclick="SearchAsync">Найти</button>
        <button class="btn btn-outline-secondary" @onclick="ClearSearchAsync" disabled="@(string.IsNullOrEmpty(appliedSearch) && string.IsNullOrEmpty(searchText))">
            Сбросить
        </button>
    </div>
</div>


@if (editing != null)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@(isNew ? "Новая запись" : "Изменение записи")</h5>

            <div class="mb-3">
                <label class="form-label">Имя</label>
                <input class="form-control" @bind="nameInput" @onkeydown="OnEditKeyDown" />
            </div>

            @if (editError != null)
            {
                <div class="alert alert-danger py-2">@editError</div>
            }

            <button class="btn btn-success" @onclick="SaveAsync" disabled="@saving">
                @(saving ? "Сохранение..." : "Сохранить")
            </button>
            <button class="btn btn-secondary" @onclick="CancelEdit" disabled="@saving">Отмена</button>
        </div>
    </div>
}


@if (error != null)
{
    <div class="alert alert-danger">@error</div>
}


@if (loading)
{
    <p>Загрузка...</p>
}
else if (items.Count == 0)
{
    <p>Записей нет.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Имя</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEdit(item)">Изменить</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(item)">Удалить</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-outline-primary" @onclick="PrevPageAsync" disabled="@(page <= 0)">Назад</button>
        <span role="status">Страница @(page + 1) из @MaxPage</span>
        <button class="btn btn-outline-primary" @onclick="NextPageAsync" disabled="@(page + 1 >= MaxPage)">Вперёд</button>
        <span class="text-muted">Всего: @total</span>
    </div>
}


@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter, EditorRequired]
    public INamedService<TEntity> Service { get; set; } = default!;

    [Parameter]
    public string DeleteQuestion { get; set; } = "Удалить запись? Связи с фильмами тоже будут удалены.";

    [Parameter]
    public int PageSize { get; set; } = 50;


    private List<TEntity> items = new();
    private int page;
    private int total;
    private string searchText = "";
    private string appliedSearch = "";
    private bool loading = true;
    private string? error;

    private TEntity? editing;
    private bool isNew;
    private string nameInput = "";
    private string originalName = "";
    private string? editError;
    private bool saving;

    private int MaxPage => Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));


    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }


    private async Task LoadAsync()
    {
        loading = true;
        error = null;

        try
        {
            int count = string.IsNullOrWhiteSpace(appliedSearch)
                ? await Service.GetCountAsync()
                : await Service.GetCountByNameAsync(appliedSearch);

            total = count;

            if (page > MaxPage - 1)
                page = MaxPage - 1;

            if (page < 0)
                page = 0;

            items = string.IsNullOrWhiteSpace(appliedSearch)
                ? await Service.GetAllAsync(PageSize, page)
                : await Service.SearchByNameAsync(appliedSearch, PageSize, page);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }


    private void StartAdd()
    {
        editing = new TEntity();
        isNew = true;
        nameInput = "";
        originalName = "";
        editError = null;
    }


    private void StartEdit(TEntity item)
    {
        editing = item;
        isNew = false;
        nameInput = item.Name ?? "";
        originalName = item.Name ?? "";
        editError = null;
    }


    private void CancelEdit()
    {
        if (editing != null && !isNew)
            editing.Name = originalName;

        editing = null;
        editError = null;
    }


    private async Task SaveAsync()
    {
        if (editing == null)
            return;

        string name = nameInput.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            editError = "Имя не может быть пустым.";
            return;
        }

        saving = true;
        editError = null;

        try
        {
            editing.Name = name;

            var result = isNew
                ? await Service.AddAsync(editing)
                : await Service.UpdateAsync(editing);

            if (!result.Success)
            {
                editError = string.Join("; ", result.Errors.Select(x => x.Message));
                return;
            }

            editing = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            editError = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }


    private async Task DeleteAsync(TEntity item)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"{DeleteQuestion}\n{item.Name}");
        if (!confirmed)
            return;

        error = null;

        try
        {
            await Service.DeleteAsync(item.Id);

            if (editing != null && ReferenceEquals(editing, item))
                editing = null;

            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = $"Не удалось удалить запись: {ex.Message}";
        }
    }


    private async Task SearchAsync()
    {
        appliedSearch = searchText.Trim();
        page = 0;
        await LoadAsync();
    }


    private async Task ClearSearchAsync()
    {
        searchText = "";
        appliedSearch = "";
        page = 0;
        await LoadAsync();
    }


    private async Task OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SearchAsync();
    }


    private async Task OnEditKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SaveAsync();
    }


    private async Task PrevPageAsync()
    {
        if (page <= 0)
            return;

        page--;
        await LoadAsync();
    }


    private async Task NextPageAsync()
    {
        if (page + 1 >= MaxPage)
            return;

        page++;
        await LoadAsync();
    }
}
